type PhoneCheckState = 'locked' | 'passcode' | 'refused' | 'viewing' | 'ended';

interface PhoneCheckDecision {
  agreed: boolean;
  passcode: string;
  passcodeHint: string;
  reply: string;
  reason: string;
}

const PHONE_CHECK_KEYWORDS = [
  '查手机', '看你手机', '给我看', '手机给我', '让我看看',
  'check your phone', 'let me see your phone', 'phone check',
  '看看你手机', '给我看看你手机', '手机拿来', '查岗',
  '看手机', '检查手机', '翻手机', '看看手机',
  '查查你', '查查手机', '查个手机', '我看你手机',
  '给我看看', '让我检查', '拿来我看', '手机检查',
];

const isPhoneCheckTrigger = (text: string): boolean => {
  const normalized = text.toLowerCase().replace(/\s/g, '');
  // Exact keyword match
  if (PHONE_CHECK_KEYWORDS.some(kw => normalized.includes(kw.toLowerCase().replace(/\s/g, '')))) {
    return true;
  }
  // Flexible: text contains both "查" and "手机" within proximity
  const hasCha = normalized.includes('查');
  const hasPhone = normalized.includes('手机');
  if (hasCha && hasPhone && normalized.length < 15) {
    return true;
  }
  return false;
};

